{
  "name": "丁点记账",
  "short_name": "丁点记账",
  "description": "丁点记账：离线优先的个人记账 App，分账户、分类预算、报表与多设备同步。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "theme_color": "#3eb489",
  "background_color": "#f5fbf8",
  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "记一笔",
      "short_name": "记账",
      "url": "./index.html#/add"
    },
    {
      "name": "看明细",
      "short_name": "明细",
      "url": "./index.html#/list"
    },
    {
      "name": "本月报表",
      "short_name": "报表",
      "url": "./index.html#/report"
    }
  ]
}
