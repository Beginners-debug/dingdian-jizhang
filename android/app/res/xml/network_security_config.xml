<?xml version="1.0" encoding="utf-8"?>
<!-- LAN sync talks plain http to a box on the same wifi, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
